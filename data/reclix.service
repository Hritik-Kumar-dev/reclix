# systemd user service unit for reclix-service.
# Install to: ~/.config/systemd/user/reclix.service
# Enable with: systemctl --user enable --now reclix.service

[Unit]
Description=Reclix screen recorder service
Documentation=https://github.com/reclix/reclix
# Start after the graphical session is available.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Adjust path after `cargo install` or package install.
ExecStart=%h/.cargo/bin/reclix-service
Restart=on-failure
RestartSec=3s

# Keep idle CPU near zero — reclix-service blocks in tokio select!().
Nice=5
# Allow real-time priority for PipeWire audio thread.
LimitRTPRIO=99
LimitNICE=-5

# Journal logging — view with: journalctl --user -u reclix -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=reclix

# Environment
Environment="RECLIX_LOG=reclix=info,warn"

[Install]
WantedBy=graphical-session.target
